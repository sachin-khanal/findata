# Copy to .env and fill in. .env is git-ignored.
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# Where findata keeps its SQLite DB and encryption key (default: ~/.findata)
# FINDATA_DATA_DIR=~/.findata

# Where the master encryption key is kept: auto (OS keychain, falling back to an owner-only
# file when there is no keychain, e.g. headless Linux or containers) | keychain | file
# FINDATA_KEY_BACKEND=auto
