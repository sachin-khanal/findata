# Copy to .env and fill in. .env is git-ignored.
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# Where findata keeps its SQLite DB and encryption key (default: ~/.findata)
# FINDATA_DATA_DIR=~/.findata

# Where the master encryption key is kept: auto (OS keychain, falling back to an owner-only
# master.key file when no keychain is available) | keychain | file
# FINDATA_KEY_BACKEND=auto

# Optional: country codes passed to Plaid Link (JSON list; default: ["US"])
# PLAID_COUNTRY_CODES=["US"]

# Optional: bind address and port for `findata serve web` (loopback only: 127.0.0.1, ::1, localhost)
# FINDATA_HOST=127.0.0.1
# FINDATA_PORT=8765
